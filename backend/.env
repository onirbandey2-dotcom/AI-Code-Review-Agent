# CodeSage AI - Development Environment Configuration
APP_NAME=CodeSage AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=codesage-dev-secret-key-change-in-production-12345
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Database - Use SQLite for development (swap to PostgreSQL in production)
DATABASE_URL=sqlite+aiosqlite:///./codesage_dev.db

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175","http://localhost:5176","http://localhost:5177","http://127.0.0.1:5173","http://192.168.0.106:5173"]

# LLM (disable for dev)
LLM_PROVIDER=ollama
LLM_MODEL=llama3:70b
LLM_API_BASE=http://localhost:11434

# Vector DB
VECTOR_DB_TYPE=chroma
VECTOR_DB_PATH=./data/vector_store

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=text

